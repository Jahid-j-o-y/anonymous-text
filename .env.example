# MongoDB Connection String (from MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://your_username:your_password@cluster0.mongodb.net/anonymous_text?retryWrites=true&w=majority"

# JWT Secret Key (Generate a random 32+ character string for production)
# Example command to generate: openssl rand -base64 32
JWT_SECRET="super-secret-random-jwt-key-change-this-for-production-min-32-chars"

# Seed Admin credentials (used by `npm run seed:admin`)
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@ChangeMe123!"

# Node Environment
NODE_ENV="development"

